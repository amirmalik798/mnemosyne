# Privileged migration/administration connection. Never use this role in the running Next.js app.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mnemosyne

# Dedicated runtime role: NOSUPERUSER, NOBYPASSRLS, not table owner,
# and no CREATE privilege on public. See README for setup SQL.
APP_DATABASE_URL=postgresql://mnemosyne_app:replace_with_strong_password@127.0.0.1:5432/mnemosyne

# Remote production PostgreSQL must use verified TLS.
# PGSSLMODE=verify-full

# Generate with openssl rand -hex 32. Keep stable and backed up.
SESSION_ENCRYPTION_SECRET=replace_with_64_hex_characters

# Canonical public app origin.
APP_BASE_URL=http://localhost:3000

# Google Apps Script Web App deployment URL ending in /exec.
GOOGLE_APPS_SCRIPT_URL=

# Generate with openssl rand -hex 32; put the same value in Apps Script
# Script Property MNEMOSYNE_EMAIL_SECRET.
GOOGLE_APPS_SCRIPT_SECRET=

# Existing single-user installations only. Set before the first multi-user
# db:migrate to assign the old archive to this email. Leave blank on fresh DBs.
MNEMOSYNE_LEGACY_OWNER_EMAIL=

# Legacy encrypted file fallback only; new images are stored in PostgreSQL.
STORAGE_DIR=./storage

# Set NODE_ENV=production in production. HTTPS is required for secure cookies.
