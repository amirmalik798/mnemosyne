# PostgreSQL connection string. Create the database before running migrations.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mnemosyne

# Generate with: openssl rand -hex 32
# Must remain stable; changing it invalidates active sessions.
SESSION_ENCRYPTION_SECRET=replace_with_64_hex_characters

# Optional: absolute directory for encrypted image files.
STORAGE_DIR=./storage

# Set NODE_ENV=production in production. HTTPS is required for secure cookies.
